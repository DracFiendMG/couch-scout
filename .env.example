# ==========================================
# CouchScout Environment Configuration
# ==========================================

# Server
PORT=3000
NODE_ENV=development

# ------------------------------------------
# Gemma Open-Weight AI Model Configuration
# ------------------------------------------
# CouchScout uses Gemma (Google's open-weight model) for autonomous reasoning.
# Mode options: "ollama" (local), "openai-compatible" (Groq, OpenRouter, etc.), or "gemini" (Google AI Studio)
GEMMA_PROVIDER=ollama
GEMMA_MODEL=gemma2:9b
# For Ollama (default local):
GEMMA_BASE_URL=http://localhost:11434/v1
# For OpenAI-compatible provider (e.g. Groq with gemma2-9b-it, OpenRouter):
GEMMA_API_KEY=

# ------------------------------------------
# Browserbase & Stagehand Configuration
# ------------------------------------------
# If BROWSERBASE_API_KEY is provided, Stagehand connects to cloud Browserbase browsers.
# If left empty, Stagehand automatically runs locally using Playwright Chromium!
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Headless mode for local browser: true / false
STAGEHAND_HEADLESS=true

# ------------------------------------------
# Temporal Durable Execution
# ------------------------------------------
# Connect to local Temporal server ("localhost:7233") or Temporal Cloud.
# If TEMPORAL_ENABLED=false, CouchScout seamlessly uses an in-memory durable coordinator.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_CERT_PATH=
TEMPORAL_KEY_PATH=

# ------------------------------------------
# Sentry Agent Tracing & Observability
# ------------------------------------------
# Sentry DSN for performance tracing, LLM token logging, and error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ------------------------------------------
# Custom Domain / Deployment
# ------------------------------------------
APP_URL=http://localhost:3000
